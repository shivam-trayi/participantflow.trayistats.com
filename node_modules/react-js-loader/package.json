{
  "name": "react-js-loader",
  "version": "0.1.5",
  "description": "animation loader and spinner for react js",
  "main": "index.js",
  "types": "index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "index.js",
    "index.d.ts",
    "Box/**",
    "Bubble/**",
    "Spinner/**",
    "Heart/**",
    "Ekvalayzer/**",
    "Hourglass/**",
    "Services/**"
  ],
  "exports": {
    ".":                  "./index.js",
    "./Box/Box1":         "./Box/Box1/index.js",
    "./Box/Box2":         "./Box/Box2/index.js",
    "./Box/Box3":         "./Box/Box3/index.js",
    "./Box/Box4":         "./Box/Box4/index.js",
    "./Box/Box5":         "./Box/Box5/index.js",
    "./Box/Box6":         "./Box/Box6/index.js",
    "./Box/Box7":         "./Box/Box7/index.js",
    "./Bubble/Bubble1":   "./Bubble/Bubble1/index.js",
    "./Bubble/Bubble2":   "./Bubble/Bubble2/index.js",
    "./Bubble/Bubble3":   "./Bubble/Bubble3/index.js",
    "./Bubble/Bubble4":   "./Bubble/Bubble4/index.js",
    "./Bubble/Bubble5":   "./Bubble/Bubble5/index.js",
    "./Spinner/Spinner1": "./Spinner/Spinner1/index.js",
    "./Spinner/Spinner2": "./Spinner/Spinner2/index.js",
    "./Spinner/Spinner3": "./Spinner/Spinner3/index.js",
    "./Heart":            "./Heart/index.js",
    "./Ekvalayzer":       "./Ekvalayzer/index.js",
    "./Hourglass":        "./Hourglass/index.js"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmurikKhoyetsyan/react-js-loader.git"
  },
  "keywords": [
    "spinner", "loader", "react-js-loader", "react-js-spinner",
    "animation", "spin", "loading", "react-loader", "react-spinner",
    "react-component", "smart-loader", "ping"
  ],
  "author": "Amur Khoyetsyan",
  "license": "MIT",
  "dependencies": {
    "normalize-colors": "^0.0.1"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "bugs": {
    "url": "https://github.com/AmurikKhoyetsyan/react-js-loader/issues"
  },
  "homepage": "https://github.com/AmurikKhoyetsyan/react-js-loader#readme"
}
